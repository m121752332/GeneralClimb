rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 玩家自訂名稱：{ name, nameUpdatedAt }，只能讀寫自己的。
    // 名稱 NAME_MIN–NAME_MAX 字（core/PlayerName.ts），只能是中英文、數字、底線、空白、連字號，
    // 頭尾不能是空白；改名之間至少隔 RENAME_COOLDOWN_SEC 秒（levels.json cloud.renameCooldownSec）。
    // tests/player-name.test.ts 會檢查這裡的數字與程式一致。
    match /players/{uid} {
      function validProfile(d) {
        return d.keys().hasOnly(['name', 'nameUpdatedAt'])
          && d.name is string
          && d.name.size() >= 2 && d.name.size() <= 12 // player name
          && d.name.matches('^[\\p{Han}A-Za-z0-9_-]([\\p{Han}A-Za-z0-9_ -]*[\\p{Han}A-Za-z0-9_-])?$')
          && d.nameUpdatedAt == request.time;
      }

      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid) && validProfile(request.resource.data);
      // 改名只能動名稱與時間，且距上次改名至少 30 秒。
      allow update: if signedInAs(uid)
        && validProfile(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameUpdatedAt'])
        && request.time >= resource.data.nameUpdatedAt + duration.value(30, 's');
      allow delete: if signedInAs(uid);
    }

    // 玩家自己的每局紀錄（players/{uid} 底下的子集合）
    match /players/{uid}/{sub}/{doc=**} {
      allow read, write: if signedInAs(uid);
    }

    // 最佳紀錄（樓層／時間排行榜之後查這裡）
    match /best/{uid} {
      allow read: if true;
      allow write: if signedInAs(uid)
        && request.resource.data.maxFloor is int
        && request.resource.data.maxFloor <= 102          // 102 = 塔尖
        && (request.resource.data.bestClearMs == null
            || request.resource.data.bestClearMs >= 300000); // 低於 5 分鐘視為不合理，實測後調整
    }

    // 登頂次數排行榜（ADR-09）：{ name, count, updatedAt }，任何人可讀、只能寫自己的。
    // 防作弊第一層：count 只能變大，且每多 1 次至少要隔 MIN_SUMMIT_SEC 秒（真實登頂一輪的最短時間）。
    // MIN_SUMMIT_SEC = levels.json cloud.minSummitSec（300），tests/cloud-summit.test.ts 會檢查兩邊一致。
    match /summits/{uid} {
      function validShape(d) {
        return d.keys().hasOnly(['name', 'count', 'updatedAt', 'bestRunMs'])
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 24 // 程式截到 12 字，留給 emoji 等多碼字元
          && d.count is int;
      }

      // 最快時間（第 1 關到塔尖一次不墜落，毫秒）：只能變快（新值 <= 舊值；相同代表沒改），
      // 有了就不能刪掉，且不得低於 MIN_RUN_MS = 420000（7 分鐘）。理論最快：
      // 101 層 × 12 列 + 尖塔 2 × 48 列 = 1308 步 × cellSec 0.35 秒 ≈ 457.8 秒，還沒算強風／下雨／
      // 老鷹一定要停下來的時間，7 分鐘留約 8% 餘裕。
      // MIN_RUN_MS = levels.json cloud.minRunSec × 1000，tests/run-time.test.ts 會檢查兩邊一致。
      function bestRunOk(d, old) {
        return (!('bestRunMs' in d) && (old == null || !('bestRunMs' in old)))
          || ('bestRunMs' in d
              && d.bestRunMs is int
              && d.bestRunMs >= 420000
              && (old == null || !('bestRunMs' in old) || d.bestRunMs <= old.bestRunMs));
      }

      allow read: if true;

      // 第一次上傳只能是 1 次。
      allow create: if signedInAs(uid)
        && validShape(request.resource.data)
        && bestRunOk(request.resource.data, null)
        && request.resource.data.count == 1
        && request.resource.data.updatedAt == request.time;

      allow update: if signedInAs(uid)
        && validShape(request.resource.data)
        && bestRunOk(request.resource.data, resource.data)
        && (
          // 只改名（Google 名稱或玩家自訂名稱）／只更新最快時間：次數與時間都不動
          (request.resource.data.count == resource.data.count
            && request.resource.data.updatedAt == resource.data.updatedAt)
          ||
          // 增加 k 次：距上次至少 k × MIN_SUMMIT_SEC 秒
          (request.resource.data.count > resource.data.count
            && request.resource.data.updatedAt == request.time
            && request.time >= resource.data.updatedAt
                 + duration.value((request.resource.data.count - resource.data.count) * 300, 's'))
        );

      // 刪除帳號：只能刪自己的（重新建立又只能從 1 次開始）。
      allow delete: if signedInAs(uid);
    }
  }
}
